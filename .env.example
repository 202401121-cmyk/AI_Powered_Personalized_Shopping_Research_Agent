# Copy to .env and fill in only what your story needs. Never commit .env.
# Sign-up steps and what to check for each key: docs/api-setup.md

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# --- LLM providers (all free tiers) -------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=                # public web text ONLY (free tier may be used for training)
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# --- Search, community, video, page reading -----------------------------------
SERPER_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=shopsense/0.1 by <your-reddit-username>
YOUTUBE_API_KEY=
JINA_API_KEY=                  # optional; raises Jina Reader's free rate limit

# --- Database and login (Supabase) --------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # backend only; never expose to the browser
DATABASE_URL=                  # postgresql://... from Supabase > Project settings > Database

# --- Frontend (browser-visible; public values only) ---------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
