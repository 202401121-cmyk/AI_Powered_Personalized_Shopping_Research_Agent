{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^q_[a-z0-9_]{1,40}$",
      "title": "Id",
      "type": "string"
    },
    "criterion_key": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
      "title": "Criterion Key",
      "type": "string"
    },
    "text": {
      "maxLength": 300,
      "minLength": 5,
      "title": "Text",
      "type": "string"
    },
    "quick_replies": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Quick Replies",
      "type": "array"
    },
    "why_asking": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Why Asking"
    }
  },
  "required": [
    "id",
    "criterion_key",
    "text",
    "quick_replies",
    "why_asking"
  ],
  "title": "InterviewQuestion",
  "type": "object"
}
