{
  "$defs": {
    "CommunitySignal": {
      "additionalProperties": false,
      "description": "US-42: whether communities agree about a product.",
      "properties": {
        "product_id": {
          "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
          "title": "Product Id",
          "type": "string"
        },
        "label": {
          "enum": [
            "consistent",
            "split",
            "single_source"
          ],
          "title": "Label",
          "type": "string"
        },
        "communities": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Communities",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "product_id",
        "label",
        "communities",
        "note"
      ],
      "title": "CommunitySignal",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Canonical display name",
          "maxLength": 150,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "brand": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "kind": {
          "default": "product",
          "description": "product_type for commodities like 'ring-shank nails'",
          "enum": [
            "product",
            "product_type"
          ],
          "title": "Kind",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Aliases",
          "type": "array"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/Variant"
          },
          "maxItems": 20,
          "title": "Variants",
          "type": "array"
        },
        "recommender_count": {
          "default": 0,
          "description": "Distinct authors who recommended it",
          "minimum": 0,
          "title": "Recommender Count",
          "type": "integer"
        },
        "weighted_mentions": {
          "default": 0.0,
          "description": "Mentions after the 180-day half-life",
          "minimum": 0,
          "title": "Weighted Mentions",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "brand",
        "kind",
        "aliases",
        "variants",
        "recommender_count",
        "weighted_mentions"
      ],
      "title": "Product",
      "type": "object"
    },
    "ResolvedValue": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
          "title": "Product Id",
          "type": "string"
        },
        "criterion_key": {
          "description": "A criterion key, or a hard-rule attribute such as 'ram_gb'",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Criterion Key",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ValueState"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "supporting_claim_ids": {
          "items": {
            "pattern": "^clm_[a-f0-9]{8,64}$",
            "type": "string"
          },
          "title": "Supporting Claim Ids",
          "type": "array"
        },
        "conflicting_claim_ids": {
          "items": {
            "pattern": "^clm_[a-f0-9]{8,64}$",
            "type": "string"
          },
          "title": "Conflicting Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "criterion_key",
        "state",
        "score",
        "value",
        "confidence",
        "supporting_claim_ids",
        "conflicting_claim_ids"
      ],
      "title": "ResolvedValue",
      "type": "object"
    },
    "ValueState": {
      "enum": [
        "known",
        "disputed",
        "unknown",
        "estimated"
      ],
      "title": "ValueState",
      "type": "string"
    },
    "Variant": {
      "additionalProperties": false,
      "description": "DR-02: versions that differ in price or specs are separate variants of one product.",
      "properties": {
        "id": {
          "pattern": "^var_[A-Za-z0-9_-]{3,64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "description": "e.g. '16 GB RAM / 512 GB SSD / India'",
          "maxLength": 120,
          "title": "Label",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "e.g. {'ram': '16GB', 'region': 'IN'}",
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "attributes"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What a results card needs besides the ranking itself.",
  "properties": {
    "product": {
      "$ref": "#/$defs/Product"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/ResolvedValue"
      },
      "title": "Values",
      "type": "array"
    },
    "community": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommunitySignal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "product",
    "values",
    "community"
  ],
  "title": "ProductSummary",
  "type": "object"
}
