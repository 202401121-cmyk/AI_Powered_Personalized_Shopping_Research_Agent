{
  "additionalProperties": false,
  "description": "US-42: whether communities agree about a product.",
  "properties": {
    "product_id": {
      "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
      "title": "Product Id",
      "type": "string"
    },
    "label": {
      "enum": [
        "consistent",
        "split",
        "single_source"
      ],
      "title": "Label",
      "type": "string"
    },
    "communities": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Communities",
      "type": "array"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    }
  },
  "required": [
    "product_id",
    "label",
    "communities",
    "note"
  ],
  "title": "CommunitySignal",
  "type": "object"
}
