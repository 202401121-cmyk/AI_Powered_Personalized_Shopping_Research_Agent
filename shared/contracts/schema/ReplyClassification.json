{
  "$defs": {
    "ReplyType": {
      "enum": [
        "answer",
        "question",
        "answer_with_question",
        "skip",
        "correction",
        "off_topic",
        "unclear"
      ],
      "title": "ReplyType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reply_type": {
      "$ref": "#/$defs/ReplyType"
    },
    "weight": {
      "anyOf": [
        {
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Weight implied by the answer, if any",
      "title": "Weight"
    },
    "user_question": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Question"
    },
    "corrects_question_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrects Question Id"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "classified_by": {
      "default": "llm",
      "enum": [
        "llm",
        "fallback"
      ],
      "title": "Classified By",
      "type": "string"
    }
  },
  "required": [
    "reply_type",
    "weight",
    "user_question",
    "corrects_question_id",
    "confidence",
    "classified_by"
  ],
  "title": "ReplyClassification",
  "type": "object"
}
